generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no enums; string fields below are validated with Zod at the API layer.

model Refund {
  id               String   @id @default(cuid())
  orderId          String   @unique
  customerName     String
  customerEmail    String
  amountCents      Int
  currency         String   @default("USD")
  reason           String
  status           String   @default("PENDING") // PENDING | FLAGGED | APPROVED | REJECTED
  decidedByClerkId String?
  decidedByEmail   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model FeatureFlag {
  id               String   @id @default(cuid())
  key              String   @unique
  description      String
  state            String   @default("OFF") // OFF | ON | PERCENTAGE
  rolloutPercent   Int      @default(0) // 0-100, only meaningful when state = PERCENTAGE
  updatedByClerkId String?
  updatedByEmail   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorClerkId String
  actorEmail   String
  action       String // e.g. refund.approve, refund.flag, flag.update, auth.sign_in
  entityType   String // refund | feature_flag | auth
  entityId     String
  before       String? // JSON snapshot before the mutation
  after        String? // JSON snapshot after the mutation
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([actorClerkId])
}
